{
  "name": "mopai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "墨排 · 本地 Markdown 微信公众号排版工作台",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "chokidar": "^4.0.3",
    "dompurify": "^3.2.7",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
